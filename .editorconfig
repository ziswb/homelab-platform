# Editor settings, see https://editorconfig.org.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,j2,toml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
