# {{ ansible_managed }} — roles/ssh_access
# First value wins in sshd_config; 10- sorts before cloud-init's
# 50-cloud-init.conf and Rocky's 50-redhat.conf, and the Include sits at the
# top of sshd_config on both distributions.
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
