apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: traefik-dashboard-tls
  namespace: traefik
spec:
  secretName: traefik-dashboard-tls-secret
  issuerRef:
    name: homelab-ca
    kind: ClusterIssuer
  dnsNames:
    - {{ traefik_install_dashboard_host }}
  duration: 8760h # 1 year
  renewBefore: 720h # 30 days
