apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/component: exporter
    app.kubernetes.io/name: kube-state-metrics
    app.kubernetes.io/part-of: kube-prometheus
    app.kubernetes.io/version: 2.20.0
  name: kube-state-metrics
  namespace: monitoring
spec:
  revisionHistoryLimit: 2
  replicas: 1
  # NOTE: upstream's examples/standard selector is only app.kubernetes.io/name.
  # Ours has carried three labels since 2.13.0 and selectors are immutable, so
  # this must stay as it is — narrowing it would make the apply fail.
  selector:
    matchLabels:
      app.kubernetes.io/component: exporter
      app.kubernetes.io/name: kube-state-metrics
      app.kubernetes.io/part-of: kube-prometheus
  template:
    metadata:
      labels:
        app.kubernetes.io/component: exporter
        app.kubernetes.io/name: kube-state-metrics
        app.kubernetes.io/part-of: kube-prometheus
        app.kubernetes.io/version: 2.20.0
    spec:
      automountServiceAccountToken: true
      containers:
{# renovate: datasource=docker depName=registry.k8s.io/kube-state-metrics/kube-state-metrics #}
        - image: registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.20.0
          livenessProbe:
            httpGet:
              path: /livez
              port: http-metrics
            initialDelaySeconds: 5
            timeoutSeconds: 5
          name: kube-state-metrics
          ports:
            - containerPort: 8080
              name: http-metrics
            - containerPort: 8081
              name: telemetry
          # Raised from 20m/40Mi at the 2.20.0 re-vendor: the ClusterRole had been
          # stuck at 2.13.0, so the endpointslices collector (a default since
          # 2.19.0) was failing RBAC and caching nothing. Now that it works it
          # holds every EndpointSlice in memory, and 23Mi of the old 40Mi limit
          # was already in use.
          resources:
            limits:
              cpu: 100m
              memory: 128Mi
            requests:
              cpu: 10m
              memory: 32Mi
          readinessProbe:
            httpGet:
              path: /readyz
              port: telemetry
            initialDelaySeconds: 5
            timeoutSeconds: 5
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65534
            seccompProfile:
              type: RuntimeDefault
      nodeSelector:
        kubernetes.io/os: linux
      serviceAccountName: kube-state-metrics
