apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: alloy
  namespace: logging
  labels:
    app: alloy
spec:
  revisionHistoryLimit: 2
  selector:
    matchLabels:
      app: alloy
  template:
    metadata:
      labels:
        app: alloy
    spec:
      serviceAccountName: alloy
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      containers:
        - name: alloy
{# renovate: datasource=docker depName=grafana/alloy #}
          image: grafana/alloy:v1.21.3
          securityContext:
            runAsUser: 0
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
              add:
                - DAC_READ_SEARCH
            seccompProfile:
              type: RuntimeDefault
          args:
            - run
            - /etc/alloy/config.alloy
            - --storage.path=/var/lib/alloy/data
            - --server.http.listen-addr=0.0.0.0:12345
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
          volumeMounts:
            - name: config
              mountPath: /etc/alloy
            - name: pods-logs
              mountPath: /var/log/pods
              readOnly: true
            - name: data
              mountPath: /var/lib/alloy/data
{% for d in alloy_extra_log_files | map(attribute='path') | map('dirname') | unique %}
            - name: extra-{{ loop.index }}
              mountPath: {{ d }}
              readOnly: true
{% endfor %}
      volumes:
        - name: config
          configMap:
            name: alloy-config
        - name: pods-logs
          hostPath:
            path: /var/log/pods
        - name: data
          hostPath:
            path: /var/lib/alloy/data
{% for d in alloy_extra_log_files | map(attribute='path') | map('dirname') | unique %}
        - name: extra-{{ loop.index }}
          hostPath:
            path: {{ d }}
            type: DirectoryOrCreate
{% endfor %}
