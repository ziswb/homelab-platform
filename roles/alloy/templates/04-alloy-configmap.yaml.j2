apiVersion: v1
kind: ConfigMap
metadata:
  name: alloy-config
  namespace: logging
data:
  config.alloy: |
    local.file_match "pods" {
      path_targets = [{"__path__" = "/var/log/pods/*/*/*.log"}]
      sync_period  = "10s"
    }

    loki.source.file "pods" {
      targets    = local.file_match.pods.targets
      forward_to = [loki.process.pods.receiver]
    }

    loki.process "pods" {
      stage.cri {}

      stage.multiline {
        firstline     = "^\\d{4}[-/]\\d{2}[-/]\\d{2}[T ]|^\\[?\\d{4}[-/]\\d{2}[-/]\\d{2}|^\\{\""
        max_wait_time = "3s"
        max_lines     = 128
      }

      stage.regex {
        source     = "filename"
        expression = "/var/log/pods/(?P<namespace>[^_]+)_(?P<pod>[^_]+)_[^/]+/(?P<container>[^/]+)/.+\\.log"
      }

      stage.labels {
        values = {
          namespace = "",
          pod       = "",
          container = "",
        }
      }

      stage.static_labels {
        values = {
          job  = "kubernetes-pods",
          node = sys.env("NODE_NAME"),
        }
      }

      forward_to = [loki.write.default.receiver]
    }

{% for f in alloy_extra_log_files %}
    local.file_match "extra_{{ loop.index }}" {
      path_targets = [{"__path__" = "{{ f.path }}"}]
      sync_period  = "10s"
    }

    loki.source.file "extra_{{ loop.index }}" {
      targets    = local.file_match.extra_{{ loop.index }}.targets
      forward_to = [loki.process.extra_{{ loop.index }}.receiver]
    }

    loki.process "extra_{{ loop.index }}" {
      stage.static_labels {
        values = {
          job  = "{{ f.job }}",
          node = sys.env("NODE_NAME"),
        }
      }

      forward_to = [loki.write.default.receiver]
    }

{% endfor %}
    loki.write "default" {
      endpoint {
        url = "{{ homelab_loki_url }}/loki/api/v1/push"
      }
    }
