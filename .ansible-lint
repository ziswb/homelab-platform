---
# ansible-lint settings. The production profile is the bar for every role and
# playbook (tier 1 CI).
profile: production
# Never install collections (into ~/.ansible or anywhere): CI and the README's
# local steps install the collection and its dependencies explicitly.
offline: true
# Deliberate exceptions are inline noqa comments with the reason, e.g.
# helm_preflight's helm_binary/helm_version_* keep their names (shared by every
# Helm role and by consuming sites; renaming is an interface change).

exclude_paths:
  - .cache/
  - .venv/
  - .github/
  # Files deployed as they are (ADR-0012), not Ansible content.
  - roles/*/files/
